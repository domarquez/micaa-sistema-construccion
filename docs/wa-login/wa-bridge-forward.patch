+/** MICAA login por WhatsApp: la instancia tiene un solo webhook (este bridge), así que reenviamos a MICAA
+ *  únicamente los mensajes directos que piden el código. Env: MICAA_LOGIN_WEBHOOK_URL
+ *  (p.ej. https://<micaa>/api/webhooks/evolution?token=<MICAA_WA_WEBHOOK_TOKEN>). Sin env -> no hace nada. */
+const MICAA_LOGIN_RE = /quiero\s+(mi\s+|el\s+|un\s+)?c[oó]digo\s+(de\s+)?micaa/i;
+async function forwardMicaaLogin(payload: any) {
+  const target = Bun.env.MICAA_LOGIN_WEBHOOK_URL;
+  if (!target) return;
+  const msgs = pickMessages(payload).filter((m) => {
+    const key = m?.key || {};
+    const jid = String(key.remoteJid || "");
+    if (key.fromMe === true || /@g\.us$|@newsletter$|@broadcast$/.test(jid)) return false;
+    return MICAA_LOGIN_RE.test(extractText(m?.message) || "");
+  });
+  if (!msgs.length) return;
+  try {
+    await fetch(target, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ event: "messages.upsert", instance: payload?.instance, data: msgs.length === 1 ? msgs[0] : { messages: msgs } }),
+      signal: AbortSignal.timeout(8000),
+    });
+    bump("micaa_login_forwarded");
+  } catch (e) {
+    console.error("micaa login forward failed", e instanceof Error ? e.message : e);
+  }
+}
